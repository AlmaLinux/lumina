# Managed by Ansible. Do not edit by hand - changes will be overwritten.
DJANGO_SETTINGS_MODULE={{ lumina_settings_module }}
DJANGO_DEBUG={{ lumina_debug | bool | ternary('1', '0') }}
DJANGO_SECRET_KEY={{ lumina_secret_key }}
DJANGO_ALLOWED_HOSTS={{ lumina_allowed_hosts }}

DB_NAME={{ lumina_db_name }}
DB_USER={{ lumina_db_user }}
DB_PASSWORD={{ lumina_db_password }}
DB_HOST={{ lumina_db_host }}
DB_PORT={{ lumina_db_port }}

VALKEY_URL={{ lumina_valkey_url }}

MEDIA_ROOT={{ lumina_media_root }}
# Hand attachment downloads to nginx once submit:attachment has authorized them. Must
# match the ``internal`` location in the vhost; empty makes Django stream them instead.
LUMINA_INTERNAL_MEDIA_LOCATION=/media/

{% if lumina_email_backend %}
EMAIL_BACKEND={{ lumina_email_backend }}
{% endif %}
EMAIL_HOST={{ lumina_email_host }}
EMAIL_PORT={{ lumina_email_port }}
DEFAULT_FROM_EMAIL={{ lumina_default_from_email }}
LUMINA_REVIEW_NOTIFY_EMAILS={{ lumina_review_notify_emails }}

OIDC_RP_CLIENT_ID={{ lumina_oidc_client_id }}
OIDC_RP_CLIENT_SECRET={{ lumina_oidc_client_secret }}
{% if lumina_oidc_scopes | default('') | length > 0 %}
OIDC_RP_SCOPES={{ lumina_oidc_scopes }}
{% endif %}
{# Only when there is an issuer to derive them from. Written unconditionally, an empty issuer
   produced OIDC_OP_AUTHORIZATION_ENDPOINT=/protocol/openid-connect/auth, which is a non-empty
   string, so "is OIDC configured?" could not be answered by looking at it. #}
{% if lumina_oidc_issuer | length > 0 %}
OIDC_OP_AUTHORIZATION_ENDPOINT={{ lumina_oidc_issuer }}/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT={{ lumina_oidc_issuer }}/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT={{ lumina_oidc_issuer }}/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT={{ lumina_oidc_issuer }}/protocol/openid-connect/certs
{% endif %}
