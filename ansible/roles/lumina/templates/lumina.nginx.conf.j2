# Managed by Ansible.
#
# Three shapes from one template:
#
#   TLS off                     port 80 serves the application.
#   TLS on                      port 80 redirects to 443, which serves it.
#   TLS wanted, no cert yet      port 80 serves the application, and the ACME challenge, so certbot
#                                can obtain the certificate that turns the previous case on.
#
# The ACME location sits above the redirect deliberately. A port-80 block that redirects everything
# breaks http-01 renewal ninety days later, which is the kind of failure that arrives on a weekend.

{% macro app_locations() %}
    # Must be >= LUMINA_BUNDLE_MAX_BYTES so alma-cert bundles reach Django's
    # own size gate instead of dying at the proxy with an opaque 413.
    client_max_body_size {{ lumina_max_bundle_mb | default(256) }}M;

    location /static/ {
        alias {{ lumina_static_root }}/;
        expires 7d;
    }

    # Submission evidence: NOT public. ``internal`` means nginx will only serve this
    # prefix in response to an X-Accel-Redirect from the application, so a client asking
    # for the path directly gets a 404 no matter how it learned about it. The authorizing
    # end is ``submit:attachment``, which allows the submitter and reviewers.
    #
    # These files sat under the public alias below with no authorization of any kind.
    # Nothing was enumerable - the path carries the submission's UUID4 - but a leaked URL
    # stayed valid forever, there was no way to revoke one, and the ``expires`` below
    # invited intermediate caches to keep copies. This block must stay *above* /media/:
    # nginx picks the longest matching prefix, so a more specific location wins.
    location /media/test-results/ {
        internal;
        alias {{ lumina_media_root }}/test-results/;
        add_header Content-Disposition "attachment" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /media/ {
        alias {{ lumina_media_root }}/;
        # Serve test-result files directly; no need to round-trip Django.
        expires 7d;

        # Everything under here is user-uploaded: result bundles, and evidence files
        # attached to a manual submission. Those attachments are arbitrary files a
        # submitter chose, they are linked from the reviewer's own page, and they are
        # served from the application's origin - so without these headers an uploaded
        # .html or .svg is stored XSS aimed squarely at reviewers and staff.
        #
        # Download, never render. Nothing here is meant to be displayed in place: a
        # bundle is fetched by tooling and an attachment is opened deliberately by a
        # human. `attachment` also neutralizes any extension the upload allowlist in
        # `lumina.core.files.validate_evidence_file` has not thought of, which is the
        # half of this pair that does not depend on getting a list right.
        add_header Content-Disposition "attachment" always;
        # And do not let a browser second-guess the declared type, which is the other
        # way an uploaded file gets executed as something it was not served as.
        add_header X-Content-Type-Options "nosniff" always;
        # No scripts, no plugins, no framing, on the off chance one is reached anyway.
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    }

    location / {
        proxy_pass http://{{ lumina_bind_tcp | bool | ternary(lumina_bind_host ~ ':' ~ lumina_bind_port, 'unix:' ~ lumina_socket ~ ':') }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
{% endmacro %}

server {
    listen 80;
    server_name {{ lumina_hostname }};

{% if lumina_certbot | bool %}
    # Served over plain HTTP always, including when everything else is redirected.
    location /.well-known/acme-challenge/ {
        root {{ lumina_acme_webroot }};
    }
{% endif %}

{% if lumina_tls_effective | bool %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
{{ app_locations() }}
{% endif %}
}

{% if lumina_tls_effective | bool %}
server {
    listen 443 ssl http2;
    server_name {{ lumina_hostname }};

    ssl_certificate     {{ lumina_tls_cert }};
    ssl_certificate_key {{ lumina_tls_key }};
    ssl_protocols TLSv1.2 TLSv1.3;

{{ app_locations() }}
}
{% endif %}
