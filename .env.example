DJANGO_SETTINGS_MODULE=lumina.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=lumina
DB_USER=lumina
DB_PASSWORD=lumina
DB_HOST=db
DB_PORT=3306

VALKEY_URL=redis://valkey:6379/0

EMAIL_HOST=mailpit
EMAIL_PORT=1025
# A hosted relay needs all four. SES SMTP credentials come from the SES console and are not AWS
# access keys; DEFAULT_FROM_EMAIL has to be an identity SES has verified.
#   EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=1
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS and EMAIL_USE_SSL are mutually exclusive: 587 is the first, 465 the second.
# EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=lumina@localhost
LUMINA_REVIEW_NOTIFY_EMAILS=reviewers@localhost
# Absolute base for links in notification emails/webhooks (no request context in the drainer).
LUMINA_SITE_BASE_URL=http://localhost:8000
# Let search engines index this deployment. Off everywhere but the production site: an indexed
# staging copy competes with production for its own queries.
LUMINA_ALLOW_INDEXING=false
# LUMINA_NOTIFICATIONS_ENABLED=1
# LUMINA_NOTIFY_DISABLED_EVENTS=run.approved,run.rejected
# A Mattermost incoming webhook the deployment owns, rather than one added in the admin: set it and
# ``manage.py configure_notifications`` creates the endpoint and posts every reviewer event to it,
# so a rebuilt database comes back with chat working. The URL is the credential; keep it out of
# anything shared. LUMINA_MATTERMOST_CHANNEL is optional and overrides the webhook's own channel.
# LUMINA_MATTERMOST_WEBHOOK_URL=https://chat.example.com/hooks/xxxxxxxxxxxxxxxxxxxxxxxxxx
# LUMINA_MATTERMOST_CHANNEL=lumina-reviews
# LUMINA_SURVEY_ENABLED=1
# LUMINA_SURVEY_IDENTITY_PEPPER=change-me-to-a-long-random-secret
# Sentry error monitoring (leave the DSN blank/unset to disable).
# SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# OIDC - fill from Keycloak dev realm export in docs/keycloak.md
OIDC_RP_CLIENT_ID=lumina
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=http://keycloak:8080/realms/lumina/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/lumina/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/lumina/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/lumina/protocol/openid-connect/certs
